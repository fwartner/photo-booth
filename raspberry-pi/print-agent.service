[Unit]
Description=Photo Booth Print Agent
After=network-online.target cups.socket cups.service
Wants=network-online.target
Requires=cups.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/print-agent
ExecStart=/home/pi/print-agent/venv/bin/python3 print_agent.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Show printed photos fullscreen on the Pi’s HDMI/desktop (X11). Adjust if not using display :0.
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

[Install]
WantedBy=multi-user.target
