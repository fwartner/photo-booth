# Environment for wifi-connect.service (Balena wifi-connect)
# Docs: https://github.com/balena-os/wifi-connect/blob/master/docs/command-line-arguments.md

# Access point shown when the Pi has no working connection
PORTAL_SSID=PhotoBooth-Setup
# Optional WPA2 password for the setup AP (empty = open network)
#PORTAL_PASSPHRASE=

# Captive portal (defaults are usually fine)
PORTAL_GATEWAY=192.168.42.1
PORTAL_LISTENING_PORT=80

# Seconds with no portal activity before giving up (0 = wait indefinitely)
# Use e.g. 600 to avoid blocking forever at boot if nobody configures Wi‑Fi
ACTIVITY_TIMEOUT=0

# UI files installed by install-wifi-connect.sh
UI_DIRECTORY=/usr/local/share/wifi-connect/ui
